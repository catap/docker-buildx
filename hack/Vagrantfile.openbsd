# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "pygolo/openbsd7"
  config.vm.box_version = "7.5"
  config.vm.boot_timeout = 900
  config.vm.synced_folder ".", "/vagrant", type: "rsync"
  config.ssh.keep_alive = true

  # use mirror which keeps old versions
  config.vm.provision "switch-mirror", type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      echo http://ftp.eu.openbsd.org/pub/OpenBSD > /etc/installurl
    SHELL
  end

  # 7.5 -> 7.6
  config.vm.provision "7.6-base", reboot: true, type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      sysupgrade -n
    SHELL
  end
  config.vm.provision "7.6-pkg", type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      pkg_add -u
    SHELL
  end

  # 7.6 -> 7.7
  config.vm.provision "7.7-base", reboot: true, type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      sysupgrade -n
    SHELL
  end
  config.vm.provision "7.7-pkg", type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      pkg_add -u
    SHELL
  end

  config.vm.provision "init", type: "shell", run: "once" do |sh|
    sh.inline = <<~SHELL
      pkg_add -x git

      ftp https://go.dev/dl/go#{ENV['GO_VERSION']}.openbsd-amd64.tar.gz
      tar -C /usr/local -xzf go#{ENV['GO_VERSION']}.openbsd-amd64.tar.gz
      ln -s /usr/local/go/bin/go /usr/local/bin/go
    SHELL
  end
end
